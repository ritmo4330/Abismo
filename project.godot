; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Abismo"
run/main_scene="res://scenes/UI/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://bmxqm8cbbldj"

[autoload]

EventBus="*res://scripts/event_bus.gd"
DataManager="*res://scripts/data_manager.gd"
Transition="*uid://c5g7yq8ccn6pt"
SceneManager="*res://scripts/scenes/scene_manager.gd"
GameManager="*res://scripts/game_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
FlowManager="*res://scripts/flow/flow_manager.gd"
CluePlacementManager="*res://scripts/clues/clue_placement_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
ToastManager="*res://scripts/UI/toast_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
TextSpeedManager="*res://scripts/text_speed_manager.gd"
InteractionFeedback="*res://scripts/UI/interaction_feedback.gd"

[dialogic]

history/simple_history_enabled=true
history/simple_history_save=true
history/visited_event_history_enabled=true
history/save_on_save=true
