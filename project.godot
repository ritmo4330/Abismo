; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Abismo"
run/main_scene="uid://qyyt35714fu4"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://bcwh7upcxi31p"

[autoload]

EventBus="*res://scripts/event_bus.gd"
DataManager="*res://scripts/data_manager.gd"
Transition="*uid://c5g7yq8ccn6pt"
SceneManager="*res://scripts/scenes/scene_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"song_lin_xi": "res://assets/characters/npcs/song_lin_xi.dch"
}
directories/dtl_directory={
"test": "res://assets/dialogues/test.dtl"
}
layout/style_directory={
"": "res://assets/UI/dialogic_style_1.tres",
"dialogic_style_1": "res://assets/UI/dialogic_style_1.tres",
"dialogic_style_2": "res://assets/UI/dialogic_style_2.tres"
}
glossary/default_case_sensitive=true
variables={}
layout/style_list=["res://assets/UI/dialogic_style_1.tres", "res://assets/UI/dialogic_style_2.tres"]
layout/default_style="res://assets/UI/dialogic_style_1.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

