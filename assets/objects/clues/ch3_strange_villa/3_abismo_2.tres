[resource]
script = ExtResource("1_ufucf")
id = "3_abismo_2"
title = "协会宣言"
description = "墙上贴着“异数观测协会”宣言：“我们将会点燃黑暗，以你留下的火；我们始终在执行彻底的抗争，直至消除所有异常的恶意；我们为此牺牲一切，我们为此爱着一切；我们不会放弃，直到找到解决的方法，直到世界恢复应有的宁静；我们将会永远守护，这个可被理解的平凡世界。”"
chapter_id = "3"
room_id = "abismo"
category_path = PackedStringArray("异墅", "异测会研究所")
