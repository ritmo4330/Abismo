[resource]
script = ExtResource("1_ufucf")
id = "3_study_darkroom_2"
title = "罗非奖报纸"
description = "书桌的书架中央夹着一张报纸，报纸的头条记载了2019年罗非奖的获奖情况。据报道，五年一届的罗非奖在该年的得主是乌叙博士带领的研究团队，罗非博士亲自为他们颁奖。据新闻背景介绍，罗非奖是弦理论专家、箱庭计划开拓者之一的罗非博士设立的奖项，用于奖励在过去的五年中为解构学的发展做出突出贡献者。"
chapter_id = "3"
room_id = "study_darkroom"
category_path = PackedStringArray("异墅", "书房暗室")
