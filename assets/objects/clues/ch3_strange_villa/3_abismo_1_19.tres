script = ExtResource("1_ufucf")
id = "3_abismo_1_19"
title = "黑门事件档案"
description = "办公桌上的一个文件袋上写着“2012年黑门事件”。内部有大量的纸质资料，详细记录了2012年的一次濒临世界末日的危机。彼时，一块漆黑的物体笼罩整座城市，它具有强大的吸引力，将高空中的一切吞噬，险些波及地表。异测会中有人议论，是1999年的那帮邪教分子导致了这场灾难，均被时任会长严厉驳回。黑门危机最终被化解，一切重回正轨，但原因至今不明。"
chapter_id = "3"
room_id = "abismo"
category_path = PackedStringArray("异墅", "异测会研究所", "深入调查")
tags = PackedStringArray("chapter_3", "strange_villa", "deep_investigation")
