[resource]
script = ExtResource("1_ufucf")
id = "3_zhou_1"
title = "梦境规则白板"
description = "休息间的墙上挂着一块白板，白板上写着某人记录下的梦境规则。\\n\\n梦境规则·周崇安研究所\\n梦境规则第一条：梦境中的场景必须以现实中的场景为蓝本，或是多个不同场景的融合；\\n梦境规则第二条：梦境中的场景能随梦中人心意的改变而改变，且无需过渡；\\n梦境规则第三条：在梦境中，无论多么荒诞不经的事情，都有可能发生；\\n梦境规则第四条：梦境中的物品能随梦中人心意的改变而出现，但出现的过程不可被观测；\\n梦境规则第五条：梦境中受到的伤害不会使梦中人死亡，但会使恐惧值不断累加；\\n梦境规则第六条：脱离梦境的方法有两种：一种为接收到足以唤醒梦中人的神经兴奋，来源包括梦境内与梦境外；另一种为恐惧值达到一定阈值而被惊醒，这将造成难以逆转的精神损害，此类精神损害简称“梦魇”；\\n梦境规则第七条：梦境中的时间流速远慢于现实，现实中的一单位时间约为梦境中十二单位时间。"
chapter_id = "3"
room_id = "zhou"
category_path = PackedStringArray("异墅", "周崇安研究所")
tags = PackedStringArray("chapter_3", "strange_villa", "scene")
clue_type = "lore"
