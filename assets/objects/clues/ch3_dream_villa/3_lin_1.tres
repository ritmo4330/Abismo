script = ExtResource("1_ufucf")
id = "3_lin_1"
title = "信纸"
description = "书桌的一角有一个千纸鹤吊坠，吊坠下压着一张信纸，纸上写着：“林玖，抱歉，这一次我无法回应你的任何求祈，这封信若能传达给你已是万幸。我发现你时，你昏迷在半山腰，无论如何也叫不醒，而乌停湘也不见了踪影。我只能先把你送到了穆执的小屋。如果我的推断没错，你应该正被困在梦境里，但我无法进入你的梦境，它就像被什么人操控着，连我都束手无策。我只能和穆执守着你的身体，祝愿你早时回来。”"
chapter_id = "3"
room_id = "lin"
category_path = PackedStringArray("梦墅", "林玖房间")
