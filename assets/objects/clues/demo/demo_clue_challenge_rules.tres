[gd_resource type="Resource" script_class="ClueData" format=3]

[ext_resource type="Script" path="res://scripts/objects/interactable/clue_data.gd" id="1_clue"]

[resource]
script = ExtResource("1_clue")
id = "demo_clue_challenge_rules"
title = "挑战读者规则"
description = "挑战读者：\n1、故事中所有出场人物均已交代完毕，故事中不存在对没有提到过的人物的隐藏。\n2、故事中不存在省力或可远程操控的机关，凶手的杀人行为均为亲力亲为。\n3、故事中记录的内容一定为客观事实，不存在假死或虚构。\n4、故事中有且仅有一个真凶，没有帮凶，而且可以直接告诉诸位读者，就是X。\n\n现在，请各位告诉我，X是如何完成以上两起案件的？"
chapter_id = "demo"
room_id = "demo_study"
category_path = PackedStringArray("Demo", "谜题", "深入调查")
tags = PackedStringArray("demo", "puzzle", "rule")
clue_type = "lore"
is_conclusion = false
highlight_visible = true
parent_clue_id = "demo_clue_puzzle_story"
child_clue_ids = PackedStringArray()

