[gd_resource type="Resource" script_class="ClueData" format=3]

[ext_resource type="Script" path="res://scripts/objects/interactable/clue_data.gd" id="1_clue"]

[resource]
script = ExtResource("1_clue")
id = "demo_conclusion_parallel_worlds"
title = "平行世界的两起案件"
description = "原来这就是作者设下的叙述性诡计的本质，X 有两种残疾，但不同时存在，说明有两个 X。环境描述的悖论从侧面反映出故事第二段众人所在的环境不是小岛，即与第一段所处环境不同，说明有两个地点。故事中有两起案件、两个死者，而管家或女仆在故事第四段并没有死，说明这两起案件没有发生在一起，而是发生在两个地点，由两个 X 各完成一起案件。一言以蔽之，这个故事中很可能存在平行世界。"
chapter_id = "demo"
room_id = "demo_study"
category_path = PackedStringArray("Demo", "谜题", "结论")
tags = PackedStringArray("demo", "puzzle", "final")
clue_type = "conclusion"
is_conclusion = true
highlight_visible = true
parent_clue_id = ""
child_clue_ids = PackedStringArray()
