script = ExtResource("1_ufucf")
id = "4_abismo_1_20"
title = "异数0373档案"
description = "办公桌上的一个文件袋上写着“异数0373”观测记录。内部有大量的纸质资料，详细记录了与0373号异数有关的信息。观测表明，异数0373是一种能量体，可附着在生命体身上，使之拥有神一般的能力，似乎每隔一段时间将更替一代。观测工作由历任会长负责，并被列为最高等级项目。现任会长时今指出，异数0373或许与黑门事件的解决有关，它不一定对世界及人类具有恶意。"
chapter_id = "4"
