script = ExtResource("1_ufucf")
id = "4_mei_1"
title = "梦境规则便笺"
description = "中央计算机上随手放着一张便笺纸，上面写着某人记录的梦境规则\\n\\n梦境规则·梅塔研究所\\n梦境规则其一：梦境中的场景必须与现实中的场景有关系，来源现实；\\n梦境规则其二：梦中人可以根据他的主观意愿自主控制梦境中的场景；\\n梦境规则其三：在梦境中任何事情都有可能发生，无视一切现实定律，因为它是虚拟的；\\n梦境规则其四：梦中人也可以控制梦境中的物品出现或改变，但是其过程不会被看到；\\n梦境规则其五：梦境中受伤不会使人死亡，但是会导致人损失精神值；\\n梦境规则其六：脱离梦境的方法有两种：一种是给予梦中人强烈刺激，现实梦中均可；另一种是精神值过低被惊醒，但是这样会导致醒来后出现不可逆的精神问题，简称“梦魇”；\\n梦境规则其七：梦境中时间流速远慢于现实，现实中的一段时间相当于梦中12倍等长的时间；\\n梦境规则其八：在梦境联通的过程中，梦境中目前行动力最强的人为梦主，梦主苏醒则所有人苏醒。所有控制梦境的行为必须满足这8条定律，在该情况下若行为间有冲突，行动力高的人的行为优先，因此行动力高的人能够给行动力低的人设置新规则。"
chapter_id = "4"
room_id = "mei"
category_path = PackedStringArray("异墅", "梅塔研究所")
tags = PackedStringArray("chapter_4", "strange_villa", "scene")
