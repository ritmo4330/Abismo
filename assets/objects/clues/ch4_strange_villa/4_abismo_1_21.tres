script = ExtResource("1_ufucf")
id = "4_abismo_1_21"
title = "沙化事件档案"
description = "办公桌上的一个文件袋上写着“沙化事件”。内部有大量的纸质资料，详细记录了2021年开始的沙化事件。据观测，各种事物乃至人类，都在无缘无故地变成沙子，沙化进程较缓慢，但若放任之，对于人类无异于灭顶之灾。观测项目由梅塔主导，经由大量观察发现，沙化事件与生活在本市孤儿院的乌停湘可能有关。会长提出用弦理论加以研究，但主导人坚决拒绝该项提议。"
chapter_id = "4"
room_id = "abismo"
category_path = PackedStringArray("异墅", "异测会研究所", "深入调查")
tags = PackedStringArray("chapter_4", "strange_villa", "deep_investigation")
