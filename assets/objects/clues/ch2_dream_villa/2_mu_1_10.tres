[resource]
script = ExtResource("1_ufucf")
id = "2_mu_1_10"
title = "旧报纸"
description = "书柜的深处有一张报纸，其上的头条记载了2017年8月4日发生在一座沿海城市的火灾事故。据报道，火灾摧毁了一座占地一千余平米别墅的主馆，别墅所有人时田丧生于火场。当时恰巧在别墅避雨的上界教会枢机卿及其随行人员提供了证词，却没找到枢机卿口中“另一位居住者”时今。该新闻的一旁留有“对不起”的笔迹。"
chapter_id = "2"
room_id = "mu"
category_path = PackedStringArray("梦墅", "穆执房间", "深入调查")
tags = PackedStringArray("chapter_2", "dream_villa", "deep_investigation")
