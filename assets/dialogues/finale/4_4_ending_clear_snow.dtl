[background scene="res://scenes/dialogic/dialogic_color_background.tscn" arg="#000000ff" fade="1.5"]
[style name="plain_text"]
leave --All--
直面过往，创造未来；直面恐惧，重获新生。过往的尘埃于斯拂去，恐惧的阴翳于斯祓除，真理的曙光于斯照耀，误会的凛冬于斯驱逐。观测者为曾名异数之人致以敬意，世界向不失崇高之人就此敞开。上下求索者追寻所失，命运拘束者破茧而还，人世相弃者重栖归宿，记忆沉眠者憧憬未来，箴言虔信者宣讲真理，初为人师者解开樊笼。此后，平衡之理既定，异数已成历史；观测之念俱存，因果修正不再。
set {Ending.Completed} = true
set {Ending.Id} = "clear_snow"
[signal arg="flow:source_character_endings"]
[end_timeline]
