[background scene="res://scenes/dialogic/dialogic_color_background.tscn" arg="#000000ff" fade="1.5"]
[style name="plain_text"]
leave --All--
穿破时空的银色子弹，直取高高在上的神明。嘴角流露出的轻蔑，铺垫玉石俱焚的死局。真理尚未勘破，狂妄者背负弑神之名。一意孤行的罪果，即是遗忘与终结的命定。尔后，世界重赋定数，箱庭再构囹圄。
set {Ending.Completed} = true
set {Ending.Id} = "godslayer"
[signal arg="flow:source_character_endings"]
[end_timeline]
