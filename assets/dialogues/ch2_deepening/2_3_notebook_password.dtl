[style name="default_visual_novel"]
[text_input text="输入密码" var="Ch2.Notebook.Password" placeholder="四位密码"]
if {Ch2.Notebook.Password} == "0909":
	密码正确，笔记本被打开了……
	do DataManager.set_flag("source_notebook/unlocked", true)
	do DataManager.add_clue("2_wu_dream_notes", "scene", "subconscious/wu/notebook")
	do FlowManager.inspect_source_clue("2_wu_dream_notes")
	你是怎么知道密码的？是运气好吗？
	do DataManager.set_flag("source_notebook/early_unlock", true)
else:
	密码错误，密码本依然被牢牢锁住
[end_timeline]
